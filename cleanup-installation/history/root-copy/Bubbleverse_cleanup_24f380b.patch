-        if not math.isclose(float(d["target_h0"]), float(target_h0), abs_tol=1e-9):
-            continue
-        if not isinstance(d.get("bestfit"), dict):
-            continue
-        if not isinstance(d.get("chi2_scientific_total"), (int, float)):
-            continue
