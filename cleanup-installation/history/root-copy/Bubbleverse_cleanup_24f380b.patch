+def checkpoint_state(outdir, expected_seed=None):
+    outdir = Path(outdir)
+    polydir = outdir / "polychord"
+    resume = [p for p in polydir.rglob("*resume*") if p.is_file()]
+    nonempty = [p for p in resume if p.stat().st_size > 0]
+    snapshot = {}
+    for p in nonempty:
+        rel = str(p.relative_to(outdir))
+        snapshot[rel] = {
+            "sha256": sha256_file(p),
+            "size": p.stat().st_size,
+            "mtime_ns": p.stat().st_mtime_ns,
+        }
+    updated = polydir / "chain.updated.yaml"
+    updated_ok = updated.is_file() and updated.stat().st_size > 0
+    seed_ok = False
+    updated_error = None
+    if updated_ok:
+        try:
+            import yaml
+            d = yaml.safe_load(updated.read_text(encoding="utf-8"))
+            sp = ((d or {}).get("sampler") or {}).get("polychord") or {}
+            got = sp.get("seed", expected_seed)
+            seed_ok = expected_seed is None or int(got) == int(expected_seed)
+        except Exception as exc:
+            updated_error = f"{type(exc).__name__}: {exc}"
+    lifecycle_path = outdir / "worker_lifecycle_v7.json"
+    lifecycle = read_json(lifecycle_path) if lifecycle_path.exists() else None
+    return {
+        "resume_files": [str(p.relative_to(outdir)) for p in resume],
+        "nonempty_resume_files": [str(p.relative_to(outdir)) for p in nonempty],
+        "resume_snapshot": snapshot,
+        "updated_yaml": str(updated.relative_to(outdir)) if updated.exists() else None,
+        "updated_yaml_nonempty": updated_ok,
+        "updated_seed_ok": seed_ok,
+        "updated_error": updated_error,
+        "lifecycle": lifecycle,
+        "resumable": bool(nonempty and updated_ok and seed_ok),
+    }
+
+
+def checkpoint_advanced(before, after):
+    if not before or not after:
+        return False
+    b = before.get("resume_snapshot") or {}
+    a = after.get("resume_snapshot") or {}
+    for path, meta in a.items():
+        if path not in b:
+            return True
+        if meta.get("sha256") != b[path].get("sha256"):
+            return True
+    return False
+
+def common_cli(a):
+    out = []
+    for k in (
+        "q032_parent_root",
+        "preflight",
+        "parent_dir",
+        "hlp_matrix",
+        "hlp_meta",
+        "reduced_support",
+        "reduced_hlp_matrix",
+        "reduced_hlp_meta",
+        "spec",
+        "source_lock",
+        "external_runtime",
+    ):
+        out += ["--" + k.replace("_", "-"), str(getattr(a, k))]
+    return out
+
+
+def polychord_segment(a):
+    spec = load_spec(a.spec)
+    load_lock(a.source_lock, a.spec)
+    runtime_gate(a.external_runtime)
+    if a.arm not in ARMS or a.model not in MODELS or a.combination not in COMBINATIONS:
+        raise RuntimeError("CELL_IDENTITY_GATE=FAIL")
+    if a.segment < 0:
+        raise RuntimeError("SEGMENT_INDEX_GATE=FAIL")
+    if a.resume_probe and a.segment == 0:
+        raise RuntimeError("RESUME_PROBE_REQUIRES_RESUME_SEGMENT_GATE=FAIL")
+
+    outdir = Path(a.output_dir)
+    outdir.mkdir(parents=True, exist_ok=True)
+    action = "fresh" if a.segment == 0 else "resume"
+    seed = cell_seed(spec, a.arm, a.model, a.combination)
+    before = None
+    if action == "resume":
+        before = checkpoint_state(outdir, seed)
+        if not before["resumable"]:
+            raise RuntimeError("PRE_RESUME_CHECKPOINT_GATE=FAIL " + json.dumps(before, sort_keys=True))
+
+    cmd = [sys.executable, str(Path(__file__).resolve()), "polychord-worker", *common_cli(a),
+           "--arm", a.arm, "--model", a.model, "--combination", a.combination,
+           "--action", action, "--output-dir", str(outdir), "--result-json", str(outdir / "worker_result.json")]
+    start = time.time()
+    proc = subprocess.Popen(cmd, start_new_session=True)
+    timed_out = False
+    try:
+        rc = proc.wait(timeout=int(a.soft_minutes) * 60)
+    except subprocess.TimeoutExpired:
+        timed_out = True
+        os.killpg(proc.pid, signal.SIGINT)
+        try:
+            rc = proc.wait(timeout=90)
+        except subprocess.TimeoutExpired:
+            os.killpg(proc.pid, signal.SIGTERM)
+            try:
+                rc = proc.wait(timeout=60)
+            except subprocess.TimeoutExpired:
+                os.killpg(proc.pid, signal.SIGKILL)
+                rc = proc.wait()
+    time.sleep(2)
+    cp = checkpoint_state(outdir, seed)
+    worker = read_json(outdir / "worker_result.json") if (outdir / "worker_result.json").exists() else None
+
+    resumed_started = True
+    if action == "resume":
+        lc = cp.get("lifecycle") or {}
+        resumed_started = (
+            lc.get("action") == "resume"
+            and lc.get("resume_input_source") == "COBAYA_STORED_UPDATED_INFO"
+            and int(lc.get("seed", -1)) == seed
+        )
+    advanced = checkpoint_advanced(before, cp) if action == "resume" else None
+
+    if rc == 0 and worker and worker.get("status") == "COMPLETE":
+        status = "COMPLETE"
+    elif a.resume_probe and action == "resume" and timed_out and before["resumable"] and cp["resumable"] and resumed_started:
+        # Probe work is deliberately discarded. It proves the stored checkpoint can be
+        # consumed in a separate interpreter/process; the real continuation restarts
+        # from the untouched uploaded parent checkpoint.
+        status = "RESUME_PROBE_PASSED"
+    elif timed_out and action == "fresh" and cp["resumable"]:
+        status = "SEGMENT_CHECKPOINTED"
+    elif timed_out and action == "fresh" and not cp["resumable"]:
+        status = "SOFT_STOP_BEFORE_RESUMABLE_CHECKPOINT"
+    elif timed_out and action == "resume" and not resumed_started:
+        status = "RESUME_PROCESS_GATE_FAILED"
+    elif timed_out and action == "resume" and cp["resumable"] and advanced:
+        status = "SEGMENT_CHECKPOINTED"
+    elif timed_out and action == "resume" and cp["resumable"] and not advanced:
+        status = "RESUME_CHECKPOINT_DID_NOT_ADVANCE"
+    else:
+        status = "FAILED"
+
+    rec = {
+        "q": Q, "case_id": CASE_ID, "program_id": PROGRAM_ID, "run_id": RUN_ID, "result_id": RESULT_ID,
+        "stage": "POLYCHORD_PRODUCTION_SEGMENT_V7", "status": status, "arm": a.arm, "model": a.model,
+        "combination": a.combination, "segment": a.segment, "action": action, "seed": seed,
+        "soft_minutes": a.soft_minutes, "resume_probe": bool(a.resume_probe),
+        "elapsed_seconds": time.time()-start, "worker_returncode": rc,
+        "timed_out": timed_out, "checkpoint_before": before, "checkpoint_after": cp,
+        "checkpoint_advanced": advanced, "resumed_process_started": resumed_started, "worker": worker,
+        "checkpoint_parent_run_id": a.parent_run_id or None,
+        "scientific_spec_origin_program_id": SCIENTIFIC_SPEC_PROGRAM_ID,
+        "scientific_spec_sha256": sha256_file(a.spec), "technical_parent_execution_commit": V1_EXECUTION_COMMIT,
+        "config_hash": canonical_hash({"spec": sha256_file(a.spec), "arm": a.arm, "model": a.model, "combination": a.combination, "seed": seed})
+    }
+    if status == "SOFT_STOP_BEFORE_RESUMABLE_CHECKPOINT":
+        rec["failure_class"] = "POLYCHORD_INITIAL_LIVE_POINT_CHECKPOINT_NOT_YET_AVAILABLE"
+    elif status == "RESUME_PROCESS_GATE_FAILED":
+        rec["failure_class"] = "CHECKPOINT_RESUME_VALIDATION_FAILURE"
+    elif status == "RESUME_CHECKPOINT_DID_NOT_ADVANCE":
+        rec["failure_class"] = "CHECKPOINT_RESUME_MADE_NO_PERSISTED_PROGRESS"
+    elif status == "FAILED":
+        rec["failure_class"] = "HPC_OR_NUMERICAL_SEGMENT_FAILURE"
+    write_json(a.segment_json, rec)
+    print("Q042_PROD_V7_SEGMENT_STATUS=" + status)
+    if status in ("COMPLETE", "SEGMENT_CHECKPOINTED", "RESUME_PROBE_PASSED"):
+        return 0
+    if status == "SOFT_STOP_BEFORE_RESUMABLE_CHECKPOINT": return 3
+    if status == "RESUME_PROCESS_GATE_FAILED": return 4
+    if status == "RESUME_CHECKPOINT_DID_NOT_ADVANCE": return 5
+    return 2
+
+def expected_bobyqa_artifact_names():
+    out = []
+    for arm in ARMS:
+        for model in MODELS:
+            for combo in COMBINATIONS:
+                for s in range(4):
+                    out.append(
+                        f"q042-prod-{V1_ROOT_RUN_ID}-bobyqa-{arm}-{model}-{combo}-s{s}"
+                    )
+    return out
