+import numpy as np
+
+Q="Q-041"
+PROGRAM_ID="Q041-PLANCKPORT-V5"
+RUN_ID="Q041-DOWNSTREAM-SCIENTIFIC-CONSEQUENCE-PORTABILITY-V5"
+RESULT_ID="R-Q041-EDE-DOWNSTREAM-PORTABILITY-005"
