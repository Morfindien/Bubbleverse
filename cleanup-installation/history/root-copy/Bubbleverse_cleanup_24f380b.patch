+                or int(x.get("mask", -1)) != mask
+                or x.get("edge") != ek
+                or int(x.get("likelihood_evaluations", -1)) != 4
+            ):
+                raise RuntimeError(f"FAMILY_CHECKPOINT_IDENTITY_GATE=FAIL {p}")
+            out[mask][ek] = x
