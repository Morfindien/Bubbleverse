+def sha256_file(path:str|Path)->str:
+    h=hashlib.sha256()
+    with Path(path).open("rb") as f:
+        for b in iter(lambda:f.read(1024*1024),b""):h.update(b)
+    return h.hexdigest()
+
+def load_spec(path:str|Path)->dict[str,Any]:
+    d=read_json(path)
