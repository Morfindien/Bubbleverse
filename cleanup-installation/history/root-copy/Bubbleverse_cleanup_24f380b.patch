-def load_lock(p, spec):
-    d = read_json(p)
-    if (
-        d.get("q"),
-        d.get("case_id"),
-        d.get("program_id"),
-        d.get("run_id"),
-        d.get("result_id"),
-    ) != (Q, CASE_ID, PROGRAM_ID, RUN_ID, RESULT_ID):
