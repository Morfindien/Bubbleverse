+    bands = c["decomposition"].get("ell_bands", [])
+    if not bands or not all(
+        isinstance(b, dict)
+        and {"name", "min", "max"}.issubset(b)
+        and float(b["min"]) <= float(b["max"])
+        for b in bands
+    ):
+        raise RuntimeError("Q017_ELL_BAND_SCHEMA_GATE=FAIL")
