-
-def q007_old_point(q007: Any, target_h0: float) -> dict[str, Any]:
-    matches = []
-    for d in walk_dicts(q007):
-        if d.get("q") != "Q-007" or d.get("status") != "PASS":
-            continue
-        if d.get("model") != "ede_n3":
