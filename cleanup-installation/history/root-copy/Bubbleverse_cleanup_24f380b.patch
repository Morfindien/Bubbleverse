+    leaked = [k for k in POLYCHORD_METADATA_ONLY_KEYS if k in pc]
+    if leaked:
+        raise RuntimeError(f"POLYCHORD_METADATA_LEAK_GATE=FAIL keys={leaked}")
+    return pc
