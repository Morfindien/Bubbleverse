+def _structured_unavailable(branch,exc,details=None):
+    return {
+        "q":Q,"run_id":RUN,"result_id":RESULT,"stage":"SECONDARY_MECHANISM","branch":branch,
+        "status":"TECHNICALLY_UNAVAILABLE",
