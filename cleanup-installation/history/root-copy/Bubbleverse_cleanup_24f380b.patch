-        residuals.append(
-            {
-                "index": ii,
-                "pol": pol,
-                "ell_eff": ell,
-                "data": data,
-                "prediction": prediction,
-                "residual": data - prediction,
-                "sigma_diag": sigma,
-                "pull_diag": ((data - prediction) / sigma) if sigma else None,
-                "signed_fullcov_chi2_attribution": c,
