+def run_matched(cfg,lock,branch):
+    if branch=="planck" or branch=="spt": return matched_planck_or_spt(cfg,lock,branch)
+    if branch=="act": return matched_act(cfg,lock)
+    raise RuntimeError("BRANCH_GATE=FAIL")
