-    delta = np.asarray(like.data_vec) - pred
-    z = like.inv_cov @ delta
-    contrib = delta * z
-    full = float(delta @ z)
-
-    by_pol: dict[str, float] = {}
-    by_band: dict[str, float] = {}
-    by_pol_band: dict[str, dict[str, float]] = {}
-    residuals = []
