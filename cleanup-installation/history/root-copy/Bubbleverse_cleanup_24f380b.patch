+def workflow_job_block(workflow_text, job_name):
+    token=f"  {job_name}:\n"
+    start=workflow_text.find(token)
+    if start<0:
+        raise RuntimeError(f"WORKFLOW_JOB_BLOCK_GATE=FAIL {job_name}")
+    # Find the next top-level (two-space) job declaration.
+    pos=start+len(token)
+    next_pos=len(workflow_text)
+    for candidate in ("  prepare:\n","  import_v10_parent:\n","  planck_extension:\n","  merge_primary:\n","  primary_endpoint_gates:\n"):
+        q=workflow_text.find(candidate,pos)
+        if q>=0 and q<next_pos:
+            next_pos=q
+    return workflow_text[start:next_pos]
+
+def static_test(cfg_path,output):
